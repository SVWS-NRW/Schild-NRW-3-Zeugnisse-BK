            ExportRTFAsBitmap = False
            MailMerge = True
            RichText = 
              '{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1031{\fonttbl{\f' +
              '0\fnil\fcharset0 Calibri;}}'#13#10'{\colortbl ;\red0\green0\blue0;}'#13#10'{' +
              '\*\generator Riched20 10.0.26100}\viewkind4\uc1 '#13#10'\pard\qj\cf1\f' +
              '0\fs24 Rechtsbehelfsbelehrung:\par'#13#10'Gegen dieses Zeugnis kann in' +
              'nerhalb eines Monats nach Bekanntgabe des Zeugnisses Widerspruch' +
              ' eingelegt werden. Der Widerspruch ist beim <dbtext datapipeline' +
              '='#39'EigeneSchule'#39'>Bezeichnung1</dbtext>, <dbtext datapipeline='#39'Eig' +
              'eneSchule'#39'>Strasse</dbtext>, <dbtext datapipeline='#39'EigeneSchule'#39 +
              '>PlzOrt</dbtext> zu erheben. \par'#13#10'Falls die Frist durch das Ver' +
              'schulden einer/eines Bevollm\'#39'e4chtigten vers\'#39'e4umt wird, wird ' +
              'dieses Verschulden der Widerspruchsf\'#39'fchrerin/dem Widerspruchsf' +
              '\'#39'fchrer zugerechnet.\super\par'#13#10#13#10'\pard\qr\nosupersub Schulnumm' +
              'er:<dbtext datapipeline='#39'EigeneSchule'#39'>SchulNr</dbtext>\par'#13#10'}'#13#10 +
              #0
