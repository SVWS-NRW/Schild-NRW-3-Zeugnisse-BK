            RichText = 
              '{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1031{\fonttbl{\f' +
              '0\fnil\fcharset0 Calibri;}}'#13#10'{\colortbl ;\red0\green0\blue0;}'#13#10'{' +
              '\*\generator Riched20 10.0.19041}\viewkind4\uc1 '#13#10'\pard\qj\cf1\b' +
              '\f0\fs20 Rechtsbehelfsbelehrung:\b0\par'#13#10'Gegen dieses Zeugnis ka' +
              'nn innerhalb eines Monats nach Bekanntgabe des Zeugnisses Widers' +
              'pruch eingelegt werden. Der Widerspruch ist beim <dbtext datapip' +
              'eline='#39'EigeneSchule'#39'>Bezeichnung1</dbtext>, <dbtext datapipeline' +
              '='#39'EigeneSchule'#39'>Strasse</dbtext>, <dbtext datapipeline='#39'EigeneSc' +
              'hule'#39'>PlzOrt</dbtext> zu erheben. \par'#13#10'Falls die Frist durch da' +
              's Verschulden einer/eines Bevollm\'#39'e4chtigten vers\'#39'e4umt wird, ' +
              'wird dieses Verschulden der Widerspruchsf\'#39'fchrerin/dem Widerspr' +
              'uchsf\'#39'fchrer zugerechnet.\par'#13#10#13#10'\pard\qr Schulnummer:<dbtext d' +
              'atapipeline='#39'EigeneSchule'#39'>SchulNr</dbtext>\par'#13#10#13#10'\pard\qj\par'#13 +
              #10'}'#13#10#0
