    object ppRichText1: TppRichText
      DesignLayer = ppDesignLayer1
      UserName = 'RichText1'
      Font.Charset = DEFAULT_CHARSET
      Font.Color = clBlack
      Font.Name = 'Calibri'
      Font.Size = 12
      Font.Style = []
      Border.mmPadding = 0
      Caption = 'RichText1'
      ExportRTFAsBitmap = False
      MailMerge = True
      RichText = 
        '{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1031{\fonttbl{\f' +
        '0\fnil\fcharset0 Calibri;}{\f1\fnil Calibri;}}'#13#10'{\colortbl ;\red' +
        '0\green0\blue0;}'#13#10'{\*\generator Riched20 10.0.19041}\viewkind4\u' +
        'c1 '#13#10'\pard\sl-320\slmult0\qc\tx3240\cf1\b\f0\fs24 Berechtigung z' +
        'um Besuch des weiterf\'#39'fchrenden Bildungsganges\b0  \f1\par'#13#10#13#10'\' +
        'pard\sl-320\slmult0\qr\tx3240\par'#13#10#13#10'\pard\sl360\slmult1\qj\tx32' +
        '40\b <dbtext>Anrede</dbtext> <dbtext>AlleVornamenName</dbtext>\b' +
        '0 geb. am \b <dbtext>Geburtsdatum</dbtext>\b0  in \b <dbtext>Geb' +
        'urtsort</dbtext>\b0\par'#13#10'\f0 hat im Schuljahr \b $Jahr$\b0  die ' +
        'Internationale F\'#39'f6rderklasse erfolgreich absolviert.\f1\line\p' +
        'ar'#13#10'<dbtext>AdressAnrede</dbtext> <dbtext>AlleVornamenName</dbte' +
        'xt> wird mit Beschluss der Klassenkonferenz vom <dbtext datapipe' +
        'line='#39'plLernabschnitte'#39'>Konferenzdatum</dbtext> \line\f0 beschei' +
        'nigt, dass <dbtext>ErSieKlein</dbtext> gem\'#39'e4\'#39'df RdErl. d. Min' +
        'isteriums f\'#39'fcr Schule und Weiterbildung vom 21.12.2009 \'#39'84Unt' +
        'erricht f\'#39'fcr Sch\'#39'fclerinnen und Sch\'#39'fcler mit Zuwanderungsge' +
        'schichte, insbesondere im Bereich der Sprachen\f1\ldblquote\f0  ' +
        'und der Verwaltungsvorschrift 23.12 zu \'#39'a7 23 Anlage A APO-BK i' +
        'n der jeweils g\'#39'fcltigen Fassung im Rahmen eines gesonderten Ve' +
        'rfahrens zur zus\'#39'e4tzlichen Feststellung des Leistungsstandes z' +
        'um Besuch des Bildungsganges\b  $Bildungsgang$\b0   berechtigt i' +
        'st. \f1\par'#13#10'\par'#13#10'\f0 Die Berechtigung zum Besuch eines weiterf' +
        '\'#39'fchrenden Bildungsganges des Berufskollegs entspricht keinem S' +
        'chulabschluss der Sekundarstufe I gem\'#39'e4\'#39'df \'#39'a7 12 Absatz. 2 ' +
        'SchulG NRW. \f1\par'#13#10'Die Berechtigung gilt in Verbindung mit dem' +
        ' Abschlusszeugnis des Bildungsganges der Ausbildungsvorbereitung' +
        ' vom <dbtext datapipeline='#39'plLernabschnitte'#39'>ZeugnisDatum</dbtex' +
        't>.\par'#13#10#13#10'\pard\par'#13#10'}'#13#10#0
      RemoveEmptyLines = False
