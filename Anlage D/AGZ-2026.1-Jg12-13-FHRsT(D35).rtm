          object ppRichText13: TppRichText
            DesignLayer = ppDesignLayer2
            UserName = 'RT_Fussnoten'
            Font.Charset = DEFAULT_CHARSET
            Font.Color = clBlack
            Font.Name = 'Calibri'
            Font.Size = 8
            Font.Style = []
            Border.mmPadding = 0
            Caption = 'RT_Fussnoten'
            ExportRTFAsBitmap = False
            RichText = 
              '{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1031\deflangfe10' +
              '31{\fonttbl{\f0\fswiss\fprq2\fcharset0 Calibri;}}'#13#10'{\colortbl ;\' +
              'red0\green0\blue0;}'#13#10'{\*\generator Riched20 10.0.26100}{\*\mmath' +
              'Pr\mdispDef1\mwrapIndent1440 }\viewkind4\uc1 '#13#10'\pard\nowidctlpar' +
              '\fi-284\li284\qj\tx284\super\f0\fs18 ___________________________' +
              '_________________\par'#13#10#13#10'\pard\nowidctlpar\fi-284\li284\qj\tx312' +
              ' 1\cf1\nosupersub\fs16\tab Der Unterricht in den modernen Fremds' +
              'prachen hat auf der nach dem Fach in Klammern angegebenen Niveau' +
              'stufe des "Europ\'#39'e4ischen Referenzrahmens f\'#39'fcr Sprachen: Lern' +
              'en, Lehren, Beurteilen" stattgefunden. Sind zwei Referenz\-nivea' +
              'us ausgewiesen, ist das niedrigere in vollem Umfang, das h\'#39'f6he' +
              're in Anteilen erreicht. Bei mindestens ausreichenden Leistungen' +
              ' (5 Punkte) wird der sprachliche Kompetenzerwerb auf diesem Nive' +
              'au bescheinigt. Die Niveaustufe bezieht sich auf das letzte Schu' +
              'lhalbjahr, in dem das Fach erteilt wurde.\par'#13#10#13#10'\pard\nowidctlp' +
              'ar\tx312\tx510\fs6\par'#13#10'\cf0\super\fs18 2\cf1\nosupersub\fs16\ta' +
              'b I\tab = sprachlich-literarisch-k\'#39'fcnstlerisches Aufgabenfeld\' +
              'par'#13#10' \tab II\tab =  gesellschaftswissenschaftliches Aufgabenfel' +
              'd\par'#13#10'\tab III\tab = mathematisch-naturwissenschaftlich-technis' +
              'ches Aufgabenfeld\par'#13#10'\fs4\par'#13#10'\cf0\super\fs18 3\cf1\nosupersu' +
              'b\fs16\tab LK\tab = Leistungskursfach\par'#13#10'\tab GK\tab = Grundku' +
              'rsfach\par'#13#10'\fs4\par'#13#10'\cf0\super\fs18 4\cf1\nosupersub\fs16\tab ' +
              'F\'#39'fcr die Umsetzung von Noten in Punkte gilt:\par'#13#10'}'#13#10#0
            RemoveEmptyLines = False
